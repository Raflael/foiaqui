{
  "expo": {
    "name": "FoiAqui",
    "slug": "foiaqui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foiaqui",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F3EE",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F3EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.raflael.foiaqui",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAyZj6_akN9A6APc_2GXxfivE8wQrVvBO0"
        }
      }
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F4F3EE"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F3EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O FoiAqui usa a câmera para mostrar as memórias no lugar onde elas aconteceram.",
          "microphonePermission": "O FoiAqui usa o microfone para você gravar o relato de uma memória.",
          "recordAudioAndroid": true
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O FoiAqui mostra as memórias do lugar onde você está. Sua localização não é guardada nem compartilhada."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O FoiAqui acessa suas fotos para você enviar a imagem de uma memória — inclusive a foto de uma foto antiga de papel.",
          "cameraPermission": "O FoiAqui usa a câmera para você fotografar a memória no próprio lugar."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c70b839-8730-47e9-a8a6-db4510aa3c43"
      }
    },
    "owner": "raflael"
  }
}
